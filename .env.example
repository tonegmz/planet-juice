# Copy these into Netlify: Project configuration > Environment variables.
# For local testing, copy this file to .env and fill it in (never commit .env).

# Password for the staff dashboard at /admin. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-something-long

# Optional: email notifications through Resend (free tier: resend.com).
# Leave blank and everything still works; check /admin for new requests.
RESEND_API_KEY=
# The "from" address must be on a domain you verified in Resend, e.g. hello@planetjuice.shop
EMAIL_FROM=Planet Juice <hello@planetjuice.shop>
# Where new bookings and pickup orders get sent
SHOP_EMAIL=

# Link emailed to people who sign up for the free 7-day meal plan.
# Put the PDF in public/downloads/ and keep this path, or point it anywhere.
MEAL_PLAN_URL=https://www.planetjuice.shop/downloads/7-day-meal-plan.pdf
